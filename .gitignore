# Environment files (never commit secrets — only .env.example is versioned)
.env
.env.dev
.env.prod
.env.e2e
.env.*.local
# Exceção: o .env.e2e do frontend não tem secrets (só isola o modo e2e do Vite)
# e é versionado; o backend/.env.e2e (credenciais Neon) segue ignorado acima.
!frontend/.env.e2e

# Python / Django
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.sqlite3
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node / frontend
node_modules/
dist/
frontend/dist/
*.local
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.obsidian/

# Build / logs
*.log
.claude/.story-automator-active
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
