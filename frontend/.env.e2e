# Exclusivo do modo e2e do Playwright (webServer: `npm run dev -- --mode e2e`).
# O modo e2e faz o Vite carregar ESTE arquivo e IGNORAR .env.development e
# .env.development.local — isola o E2E de ajustes locais de dev (ex.: apontar
# VITE_API_BASE_URL para o backend DEV :8001).

# Vazio de propósito: as chamadas /api relativas passam pelo proxy do Vite
# (vite.config.ts) para o backend e2e em :8000 (config.settings.e2e).
VITE_API_BASE_URL=

# Mantém a aparência atual do app (faixa DEV, aba DEV-bujo) nos testes E2E.
VITE_APP_ENV=development
