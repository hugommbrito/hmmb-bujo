# Prod: cross-origin base-URL of the API. Override per deploy environment.
# No /api suffix — every call already hardcodes its own /api/... path (see
# features/*/api.ts); appending /api here double-prefixes every request to
# .../api/api/... (404).
VITE_API_BASE_URL=https://your-api-host.example

# Branding do ambiente em 3 estados (ver src/shared/env.ts):
#   'local' → faixa azul "Ambiente local" (uso via .env.development.local);
#   'development' → faixa marrom de deploy DEV, aba DEV-bujo;
#   vazio/qualquer outro valor (incl. 'production') → sem faixa, aba BuJo,
#   favicon de produção — a aparência de produção é o estado neutro.
# O deploy DEV do Railway usa o 'development' abaixo; o ambiente PROD
# sobrescreve com VITE_APP_ENV=production (como já faz com VITE_API_BASE_URL).
VITE_APP_ENV=development
